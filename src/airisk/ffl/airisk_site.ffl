// Publishing the AI Risk Clock to GitHub Pages.
//
// Kept apart from airisk.ffl because it composes another domain's facet
// (census.Publish.PublishWebBundle — the shared, token-gated Pages publisher),
// so compiling it needs that domain's FFL as a library:
//
//   fw ffl run --primary airisk_site.ffl --library airisk.ffl \
//       --library <fwh_census_us>/src/census_us/handlers/publish/ffl/census_publish.ffl \
//       --library facetwork/ffl/http.ffl --workflow airisk.publish.UpdateSite
//
// The bundle lands under "ai-risk/". The publisher replaces only that subtree
// and merges the gallery landing, so other bundles are untouched. Pages
// render deterministically, so a refresh with no new data commits nothing.

namespace airisk.publish {
    use census.Publish

    /** The scheduled job: refresh every source, rebuild, publish. */
    workflow UpdateSite(repo: String = "rlemke/facetwork-maps", dest: String = "ai-risk") => (
        pages_url: String,
        files: Int,
        commit: String,
        through: String,
        accelerating: Json
    ) andThen {
        up = airisk.workflows.Update()
        published = PublishWebBundle(
            repo = $.repo,
            prefixes = [up.output_dir],
            dests = [$.dest],
            include = [".html"],
            labels = ["AI Risk Clock"]
        )
        yield UpdateSite(
            pages_url = published.pages_url,
            files = published.file_count,
            commit = published.commit,
            through = up.through,
            accelerating = up.accelerating
        )
    }
}
